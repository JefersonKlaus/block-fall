[run]
# Measure branches, not just lines: conditional expressions such as
# `a if cond else b` and short-circuiting generators are otherwise hidden.
branch = True
# Measure every module of the app (and the dev tools), including ones no test
# imports (without this, main.py silently disappears from the report).
source =
    src
    tools

[report]
show_missing = True
fail_under = 100
